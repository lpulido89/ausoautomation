---
import "../styles/global.css";
import "../styles/navbar.css";
import "../styles/hero.css";
import "../styles/services.css";
import "../styles/projects.css";
import "../styles/technologies.css";
import "../styles/about.css";
import "../styles/training.css";
import "../styles/contact.css";
import "../styles/footer.css";

interface Props {
    title?: string;
    lang?: "es" | "en";
}

const { title = "AUSO | Automation Solutions", lang = "es" } = Astro.props;
const description = lang === "es"
    ? "AUSO se especializa en automatización Siemens, bancos de demostración, laboratorios universitarios, capacitación técnica, aplicaciones industriales y captura de datos."
    : "AUSO specializes in Siemens automation, demonstration systems, university labs, technical training, industrial apps, and data collection.";
---

<!DOCTYPE html>
<html lang={lang}>

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
        name="description"
        content={description}
    />

    <link rel="alternate" hreflang="es" href="https://ausoautomation.com/" />
    <link rel="alternate" hreflang="en" href="https://ausoautomation.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://ausoautomation.com/" />

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

</head>

<body>

    <slot />

</body>

</html>
