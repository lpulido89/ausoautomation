<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>AUSO | Mis descargas</title>
  </head>
  <body>
    <main>
      <nav class="portal-nav" aria-label="Navegación del portal">
        <a href="/">← AUSO</a>
      </nav>
      <h1>Mis descargas</h1>
      <p>Abre una carpeta para ver sus archivos.</p>
      <p id="status" role="status">Cargando tus carpetas…</p>
      <div id="courses"></div>
    </main>
    <script>
      const status = document.querySelector('#status');
      const container = document.querySelector('#courses');
      const navigation = document.querySelector('.portal-nav');
      if (status && container && navigation) {
        try {
          const response = await fetch('/api/portal/courses');
          const result = await response.json();
          if (!response.ok) throw new Error(result.error);
          if (result.isAdmin === true) {
            const adminLink = document.createElement('a');
            adminLink.className = 'admin-link';
            adminLink.href = '/admin/';
            adminLink.textContent = 'Panel de administración';
            navigation.append(adminLink);
          }
          status.textContent = result.courses.length ? '' : 'Todavía no tienes carpetas compartidas.';
          for (const course of result.courses) {
            const section = document.createElement('details');
            const title = document.createElement('summary');
            title.textContent = `${course.title} · ${course.files.length} ${course.files.length === 1 ? 'archivo' : 'archivos'}`;
            section.append(title);
            if (!course.files.length) section.append('Esta carpeta está vacía.');
            for (const file of course.files) {
              const link = document.createElement('a');
              link.href = '/api/portal/download/' + encodeURIComponent(file.id);
              link.textContent = 'Descargar ' + file.name;
              section.append(link);
            }
            container.append(section);
          }
        } catch (cause) {
          status.textContent = cause instanceof Error && !(cause instanceof SyntaxError)
            ? cause.message : 'No pudimos cargar tus carpetas. Vuelve a iniciar sesión e inténtalo de nuevo.';
        }
      }
    </script>
    <style>
      :global(body) { background:#101216; color:#f3f4f6; font:1rem system-ui; margin:0; }
      main { max-width:54rem; margin:auto; padding:3rem 1.25rem; }
      a { color:#ff8996; overflow-wrap:anywhere; }
      .portal-nav { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; }
      .portal-nav :global(.admin-link) { color:#ff8996; padding:.55rem .8rem; border:1px solid #ff8996; border-radius:8px; text-decoration:none; }
      .portal-nav :global(.admin-link:hover) { background:#2c2229; }
      .portal-nav :global(.admin-link:focus-visible) { outline:2px solid currentColor; outline-offset:3px; }
      #courses :global(details) { background:#191d24; padding:1.25rem; border:1px solid #363b44; border-radius:12px; margin-top:1rem; }
      #courses :global(summary) { cursor:pointer; font-weight:700; }
      #courses :global(a) { display:block; padding:.45rem 0; color:#ff8996; overflow-wrap:anywhere; }
    </style>
  </body>
</html>
