---
import AusoCarousel from "./AusoCarousel.astro";
import ScannerDemo from "./ScannerDemo.astro";
import TechnologyMap from "./TechnologyMap.astro";

const { lang } = Astro.props;
const t = (es: string, en: string) => lang === "es" ? es : en;
---

<section class="hero" id="top">

    <div class="tech-background"></div>
    <div class="tech-lines"></div>
    <div class="hero-content container">

        <img
            src="/images/logo.png"
            alt="AUSO Automation Solutions"
            class="hero-logo"
        />

        <h1>{t("Automatización industrial y capacitación técnica", "Industrial Automation, Demonstration Systems & Technical Training")}</h1>

        <p>{t("AUSO se especializa en automatización Siemens para la industria y las universidades. Integramos maquinaria y sistemas de producción, construimos estaciones de demostración y laboratorios, y desarrollamos capacitación técnica, aplicaciones industriales y soluciones de captura de datos.", "AUSO specializes in Siemens automation for industry and universities. We integrate machinery and production systems, build demonstration stations and labs, and develop technical training, industrial apps, and data collection solutions.")}</p>

        <div class="hero-buttons">

            <a href="#projects" class="btn btn-primary">{t("Ver ejemplos de aplicación", "See Application Examples")}</a>

            <a href="#contact" class="btn btn-outline">{t("Contáctanos", "Contact Us")}</a>

        </div>

    </div>

    <div class="services-bar">

        <div class="service">
            <h3>{t("Automatización con PLC", "PLC Automation")}</h3>
            <span>S7-1200 / S7-1500</span>
        </div>

        <div class="service">
            <h3>HMI & SCADA</h3>
            <span>WinCC Unified</span>
        </div>

        <div class="service">
            <h3>{t("Variadores y control de movimiento", "Drives & Motion")}</h3>
            <span>SINAMICS / SIMOTION</span>
        </div>

        <div class="service">
            <h3>{t("Sistemas industriales", "Industrial Systems")}</h3>
            <span>{t("Redes e integración", "Networks & Integration")}</span>
        </div>

        <div class="service">
            <h3>{t("Capacitación", "Training")}</h3>
            <span>{t("Cursos y sistemas de demostración", "Courses & Demo Systems")}</span>
        </div>

    </div>

</section>
<section class="services" id="services">

    <div class="container">

        <span class="section-tag">{t("NUESTROS SERVICIOS", "OUR SERVICES")}</span>

        <h2>{t("Ingeniería industrial para fabricantes y universidades", "Industrial Engineering Services for Manufacturers and Universities")}</h2>

        <p class="section-description">{t("Desde la puesta en marcha de una máquina hasta el equipamiento de un laboratorio universitario, diseñamos en función del proceso y de quienes van a usarlo.", "From commissioning a machine to equipping a university lab, we design around the process you need to automate and the people who will use it.")}</p>

        <div class="services-grid">

            <article class="service-card">

                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="3" y="5" width="26" height="22" rx="2"/><path d="M3 10h26M3 22h26M8 7v3m5-3v3m6-3v3m5-3v3M8 22v3m5-3v3m6-3v3m5-3v3"/><circle class="service-icon-accent" cx="23" cy="16" r="1.5"/><path d="M8 15h8m-8 3h5"/></svg>

                <h3>{t("Automatización e integración de sistemas", "Automation & Systems Integration")}</h3>

                <p>{t("Programación y puesta en marcha de PLC Siemens, conexión de maquinaria a redes industriales e integración de controles en equipos nuevos y existentes.", "Siemens PLC programming and commissioning, machine networking, and control integration for new and existing production equipment.")}</p>

            </article>

            <article class="service-card">

                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="3" y="4" width="26" height="19" rx="2"/><path d="M12 28h8m-4-5v5M7 8v11h18"/><path class="service-icon-accent" d="m9 16 5-4 4 2 6-5"/></svg>

                <h3>HMI & SCADA</h3>

                <p>{t("Interfaces de operador y pantallas de supervisión con WinCC Unified para consultar estados y alarmas y controlar el proceso.", "Operator interfaces and supervisory screens built with WinCC Unified give teams access to machine status, alarms, and process controls.")}</p>

            </article>

            <article class="service-card">

                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                    <rect x="2.5" y="12" width="13" height="12" rx="2"/>
                    <path d="M6 15v6m3-6v6m3-6v6M7 12V9h4v3m4.5 4.5h4v3h-4M2 27h15"/>
                    <polygon points="28.04,10.45 29.24,11.74 28.79,12.83 27.02,12.89 26.39,13.52 26.33,15.29 25.24,15.74 23.95,14.54 23.05,14.54 21.76,15.74 20.67,15.29 20.61,13.52 19.98,12.89 18.21,12.83 17.76,11.74 18.96,10.45 18.96,9.55 17.76,8.26 18.21,7.17 19.98,7.11 20.61,6.48 20.67,4.71 21.76,4.26 23.05,5.46 23.95,5.46 25.24,4.26 26.33,4.71 26.39,6.48 27.02,7.11 28.79,7.17 29.24,8.26 28.04,9.55"/>
                    <circle class="service-icon-accent" cx="23.5" cy="10" r="2"/>
                    <polygon points="28.97,20.96 29.75,22.26 29.15,23.30 27.63,23.27 26.84,23.73 26.10,25.06 24.90,25.06 24.16,23.73 23.37,23.27 21.85,23.30 21.25,22.26 22.03,20.96 22.03,20.04 21.25,18.74 21.85,17.70 23.37,17.73 24.16,17.27 24.90,15.94 26.10,15.94 26.84,17.27 27.63,17.73 29.15,17.70 29.75,18.74 28.97,20.04"/>
                    <circle cx="25.5" cy="20.5" r="1.35"/>
                </svg>

                <h3>{t("Variadores y control de movimiento", "Drives & Motion")}</h3>

                <p>{t("Puesta en marcha de variadores SINAMICS y control de movimiento para aplicaciones que requieren regular la velocidad o coordinar varios ejes.", "SINAMICS drive commissioning and motion control for applications that require speed control or coordinated axis movement.")}</p>

            </article>

            <article class="service-card">

                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                    <path d="M5 28V4h22v24M2 28h6m16 0h6M5 16h22M5 25h22"/>
                    <rect x="8" y="7" width="12" height="6" rx="1"/>
                    <circle class="service-icon-accent" cx="23.5" cy="10" r="1"/>
                    <rect x="8" y="19" width="16" height="6" rx="1"/>
                    <path d="M13.5 19v6m5-6v6M10 22h1m4.5 0h1m4.5 0h1"/>
                </svg>

                <h3>{t("Sistemas integrados de demostración y laboratorios de automatización", "Integrated Demo Systems & Automation Labs")}</h3>

                <p>{t("Diseñamos estaciones para universidades e industria donde PLC, HMI, variadores, redes industriales y software de ingeniería trabajan juntos para controlar un proceso. Los participantes avanzan desde la configuración y programación básica hasta la integración, puesta en marcha y diagnóstico del sistema completo.", "Stations designed and built for universities and industry bring PLCs, HMIs, drives, industrial networks, and engineering software together to control a process. Participants progress from basic configuration and programming to full system integration, commissioning, and troubleshooting.")}</p>
                <a class="service-demo-link" href="#showcase">{t("Ver una estación de capacitación →", "See a training station →")}</a>

            </article>

            <article class="service-card">

                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M16 8C12 5 8 4 3 6v19c5-2 9-1 13 2 4-3 8-4 13-2V6c-5-2-9-1-13 2Zm0 0v19M7 11h5m-5 4h5m-5 4h5"/><path class="service-icon-accent" d="M20 19v-6h5v6m-5-3h5"/></svg>

                <h3>{t("Capacitación y desarrollo de contenidos técnicos", "Training & Technical Content Development")}</h3>

                <p>{t("Detectamos necesidades de capacitación y desarrollamos cursos, prácticas, guías y manuales sobre tecnologías Siemens, adaptados a tus equipos, procesos y perfiles de trabajo.", "We assess training needs and develop Siemens-focused courses, hands-on exercises, guides, and manuals tailored to your equipment, processes, and team roles.")}</p>
                <a class="service-demo-link" href="#training">{t("Ver capacitación técnica →", "Explore technical training →")}</a>

            </article>

            <article class="service-card">
                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M4 5v22h24M9 21l6-7 5 3 7-9"/><circle class="service-icon-accent" cx="27" cy="8" r="2"/></svg>
                <h3>{t("Captura de datos industriales", "Industrial Data Collection")}</h3>
                <p>{t("Captura datos de máquinas y procesos, como conteos de ciclos, alarmas y estados de operación, para trazabilidad, seguimiento de producción y reportes.", "Capture machine and process data, such as cycle counts, alarms, and operating states, for traceability, production monitoring, and reporting.")}</p>
            </article>

            <article class="service-card">
                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="8" y="3" width="16" height="26" rx="3"/><path d="M13 24h6"/><path class="service-icon-accent" d="M12 12V9h3m5 3V9h-3m-5 5v3h3m5-3v3h-3"/></svg>
                <h3>{t("Aplicaciones industriales", "Industrial Apps")}</h3>
                <p>{t("Aplicaciones para identificar equipos, consultar información técnica y recibir orientación con realidad aumentada directamente en campo.", "Apps for field teams to identify equipment, look up technical information, and get augmented reality guidance at the machine.")}</p>
                <a class="service-demo-link" href="#scanner-demo">{t("Probar la demo del escáner →", "Try the scanner demo →")}</a>
            </article>

        </div>

    </div>

</section>
<section class="projects" id="projects">

    <div class="container">

        <span class="section-tag">{t("EJEMPLOS DE APLICACIÓN", "APPLICATION EXAMPLES")}</span>

        <h2>{t("De los bancos didácticos a la modernización de maquinaria", "From Training Stations to Plant Retrofits")}</h2>

        <p class="section-description">{t("Conoce cómo aplicamos controles Siemens en sistemas de demostración, capacitación técnica y modernización de equipos.", "Explore examples of how we apply Siemens controls in demonstration systems, technical training, and equipment modernization.")}</p>

        <AusoCarousel lang={lang} />

        <div class="projects-grid">

            <article class="project-card">

                <div class="project-content">

                    <h3>{t("Banco de control de movimiento S120", "S120 Motion Control Trainer")}</h3>

                    <p>{t("Banco portátil con ejes servo sincronizados, E/S distribuidas ET200SP y control de movimiento Siemens.", "Portable industrial trainer with synchronized servo axes, ET200SP distributed I/O and Siemens Motion Control.")}</p>

                </div>

            </article>

            <article class="project-card">

                <div class="project-content">

                    <h3>{t("Celda de automatización con PLC", "PLC Automation Cell")}</h3>

                    <p>{t("Plataforma modular para prácticas con PLC, HMI, PROFINET y comunicación industrial.", "Modular automation platform for PLC, HMI, Profinet and industrial communication training.")}</p>

                </div>

            </article>

            <article class="project-card">

                <div class="project-content">

                    <h3>{t("Modernización de maquinaria", "Industrial Retrofit")}</h3>

                    <p>{t("Actualización de maquinaria existente con PLC Siemens, WinCC Unified y variadores de velocidad.", "Modernization of legacy machinery using Siemens PLCs, WinCC Unified and variable speed drives.")}</p>

                </div>

            </article>

        </div>

        <ScannerDemo lang={lang} />
    </div>

</section>
<section class="training" id="training">

    <div class="container">

        <span class="section-tag">{t("CAPACITACIÓN", "TRAINING")}</span>

        <h2>{t("Capacitación técnica industrial", "Professional Industrial Training")}</h2>

        <p class="section-description">{t("Identificamos lo que necesitan aprender ingenieros, técnicos y estudiantes. Nuestros programas sobre tecnologías Siemens combinan cursos prácticos con ejercicios, guías y manuales para consultar después de la capacitación.", "We identify what engineers, technicians, and students need to learn and build training around their work. Our Siemens-focused programs combine practical courses with exercises, guides, and manuals that participants can refer to after training.")}</p>

        <div class="training-grid">

            <article class="course-card">
                <h3>{t("Programación de PLC", "PLC Programming")}</h3>
                <p>TIA Portal · S7-1200 / S7-1500<br>STEP 7 Classic · S7-300</p>
            </article>

            <article class="course-card">
                <h3>WinCC Unified</h3>
                <p>{t("Desarrollo de HMI y SCADA", "HMI & SCADA Development")}</p>
            </article>

            <article class="course-card">
                <h3>{t("Control de movimiento", "Motion Control")}</h3>
                <p>SINAMICS & SIMOTION</p>
            </article>

            <article class="course-card">
                <h3>{t("Redes industriales", "Industrial Networks")}</h3>
                <p>PROFINET · PROFIBUS · IO-Link<br>Modbus · OPC UA · MQTT</p>
            </article>

            <article class="course-card">
                <h3>{t("Programación CNC", "CNC Programming")}</h3>
                <p>SINUMERIK 840D sl · SINUMERIK ONE</p>
            </article>

            <article class="course-card">
                <h3>{t("Capacitación a la medida", "Custom Training")}</h3>
                <p>{t("Diseñada para tu empresa", "Designed for your company")}</p>
            </article>

        </div>

        <TechnologyMap lang={lang} />

    </div>

</section>
<section class="why-auso" id="about">

    <div class="container">

        <span class="section-tag">{t("NOSOTROS", "WHY AUSO")}</span>

        <h2>{t("Especialistas en Siemens para la industria y la educación", "Siemens Expertise for Industry and Education")}</h2>

        <p class="section-description">{t("AUSO diseña sistemas de automatización y desarrolla capacitación para fabricantes y universidades. Colaboramos con nuestra empresa aliada Hitech Ingenium en proyectos con Siemens y universidades.", "AUSO is an industrial engineering company that designs automation systems and develops training for manufacturers and universities. Hitech Ingenium is an allied company that we collaborate with on projects involving Siemens and universities.")}</p>

        <div class="why-grid">

            <div class="why-item">{t("✓ Proyectos de automatización a la medida", "✓ Custom Automation Projects")}</div>

            <div class="why-item">{t("✓ Sistemas integrados de demostración y laboratorios universitarios", "✓ Integrated Demo Systems & University Labs")}</div>

            <div class="why-item">{t("✓ Especialistas en control de movimiento", "✓ Motion Control Specialists")}</div>

            <div class="why-item">{t("✓ Redes industriales", "✓ Industrial Networks")}</div>

            <div class="why-item">{t("✓ Capacitación técnica y materiales didácticos", "✓ Technical Training & Learning Materials")}</div>

            <div class="why-item">{t("✓ Soporte técnico", "✓ Technical Support")}</div>

        </div>

    </div>

</section>
<section class="contact-section" id="contact">

    <div class="container">

        <div class="contact-box">

            <span class="section-tag">{t("CONTACTO", "CONTACT")}</span>

            <h2>{t("Cuéntanos qué necesitas construir o mejorar", "Tell Us What You Need to Build or Improve")}</h2>

            <p>{t("Cuéntanos qué máquina necesitas integrar, qué laboratorio quieres equipar o qué habilidades debe desarrollar tu equipo. Para proyectos de software y datos, dinos qué tareas necesita resolver tu equipo en campo o qué quieres medir en producción.", "Tell us about the machine you need to integrate, the lab you want to equip, or the skills your team needs to develop. For software and data projects, tell us what your team needs to do in the field or track in production.")}</p>

            <div class="contact-buttons">

                <a href="mailto:contact@ausoautomation.com" class="btn btn-primary">{t("Contáctanos", "Contact Us")}</a>

                <a href="#projects" class="btn btn-outline">{t("Ver ejemplos de aplicación", "See Application Examples")}</a>

            </div>

        </div>

    </div>

</section>

<footer class="footer">

    <div class="container footer-grid">

        <div>

            <img
                src="/images/logo.png"
                alt="AUSO"
                class="footer-logo"
            >

            <p>{t("Ingeniería industrial especializada en Siemens, con sede en Monterrey, México.", "Industrial engineering with Siemens expertise, based in Monterrey, Mexico.")}</p>

        </div>

        <div>

            <h4>{t("Servicios", "Services")}</h4>

            <ul>

                <li>{t("Automatización e integración de sistemas", "Automation & Systems Integration")}</li>
                <li>{t("Sistemas de demostración y laboratorios de automatización", "Demo Systems & Automation Labs")}</li>
                <li>{t("Capacitación y contenidos técnicos", "Training & Technical Content")}</li>
                <li>{t("Aplicaciones industriales", "Industrial Apps")}</li>
                <li>{t("Captura de datos industriales", "Industrial Data Collection")}</li>

            </ul>

        </div>

        <div>

            <h4>{t("Tecnologías", "Technologies")}</h4>

            <ul>

                <li>PLC</li>
                <li>HMI</li>
                <li>{t("Variadores", "Drives")}</li>
                <li>CNC</li>

            </ul>

        </div>

        <div>

            <h4>{t("Contacto", "Contact")}</h4>

            <ul>

                <li>contact@ausoautomation.com</li>
                <li>Monterrey, México</li>

            </ul>

        </div>

    </div>

    <div class="copyright">

        © 2026 AUSO Automation Solutions

    </div>

</footer>
