---
import AusoCarousel from "./AusoCarousel.astro";
import ScannerDemo from "./ScannerDemo.astro";
---

<section class="hero" id="top">

    <div class="tech-background"></div>
    <div class="tech-lines"></div>
    <div class="hero-content container">

        <img
            src="/images/logo.png"
            alt="AUSO Automation Solutions"
            class="hero-logo"
        />

        <h1>
            Engineering Solutions for Industrial Automation
        </h1>

        <p>
            We design, program and implement reliable automation systems,
            industrial training and demo equipment focused on Siemens
            technologies, Motion Control, Drives and CNC.
        </p>

        <div class="hero-buttons">

            <a href="#projects" class="btn btn-primary">
                View Projects
            </a>

            <a href="#contact" class="btn btn-outline">
                Contact Us
            </a>

        </div>

    </div>

    <div class="services-bar">

        <div class="service">
            <h3>PLC Automation</h3>
            <span>S7-1200 / S7-1500</span>
        </div>

        <div class="service">
            <h3>HMI & SCADA</h3>
            <span>WinCC Unified</span>
        </div>

        <div class="service">
            <h3>Drives & Motion</h3>
            <span>SINAMICS / SIMOTION</span>
        </div>

        <div class="service">
            <h3>Industrial Systems</h3>
            <span>Networks & Integration</span>
        </div>

        <div class="service">
            <h3>Training</h3>
            <span>Courses & Demo Systems</span>
        </div>

    </div>

</section>
<AusoCarousel />
<section class="services" id="services">

    <div class="container">

        <span class="section-tag">
            OUR SERVICES
        </span>

        <h2>
            Engineering Solutions Built Around Siemens Technologies
        </h2>

        <p class="section-description">
            AUSO provides engineering, industrial training and portable demo systems
            focused on PLCs, Motion Control, Drives, CNC and industrial digitalization.
        </p>

        <div class="services-grid">

            <article class="service-card">

                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="3" y="5" width="26" height="22" rx="2"/><path d="M3 10h26M3 22h26M8 7v3m5-3v3m6-3v3m5-3v3M8 22v3m5-3v3m6-3v3m5-3v3"/><circle class="service-icon-accent" cx="23" cy="16" r="1.5"/><path d="M8 15h8m-8 3h5"/></svg>

                <h3>PLC Automation</h3>

                <p>
                    Siemens S7-1200 / S7-1500<br>
                    Programming & Commissioning
                </p>

            </article>

            <article class="service-card">

                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="3" y="4" width="26" height="19" rx="2"/><path d="M12 28h8m-4-5v5M7 8v11h18"/><path class="service-icon-accent" d="m9 16 5-4 4 2 6-5"/></svg>

                <h3>HMI & SCADA</h3>

                <p>
                    WinCC Unified<br>
                    Visualization Systems
                </p>

            </article>

            <article class="service-card">

                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                    <rect x="2.5" y="12" width="13" height="12" rx="2"/>
                    <path d="M6 15v6m3-6v6m3-6v6M7 12V9h4v3m4.5 4.5h4v3h-4M2 27h15"/>
                    <polygon points="28.04,10.45 29.24,11.74 28.79,12.83 27.02,12.89 26.39,13.52 26.33,15.29 25.24,15.74 23.95,14.54 23.05,14.54 21.76,15.74 20.67,15.29 20.61,13.52 19.98,12.89 18.21,12.83 17.76,11.74 18.96,10.45 18.96,9.55 17.76,8.26 18.21,7.17 19.98,7.11 20.61,6.48 20.67,4.71 21.76,4.26 23.05,5.46 23.95,5.46 25.24,4.26 26.33,4.71 26.39,6.48 27.02,7.11 28.79,7.17 29.24,8.26 28.04,9.55"/>
                    <circle class="service-icon-accent" cx="23.5" cy="10" r="2"/>
                    <polygon points="28.97,20.96 29.75,22.26 29.15,23.30 27.63,23.27 26.84,23.73 26.10,25.06 24.90,25.06 24.16,23.73 23.37,23.27 21.85,23.30 21.25,22.26 22.03,20.96 22.03,20.04 21.25,18.74 21.85,17.70 23.37,17.73 24.16,17.27 24.90,15.94 26.10,15.94 26.84,17.27 27.63,17.73 29.15,17.70 29.75,18.74 28.97,20.04"/>
                    <circle cx="25.5" cy="20.5" r="1.35"/>
                </svg>

                <h3>Drives & Motion</h3>

                <p>
                    SINAMICS<br>
                    Motion Control
                </p>

            </article>

            <article class="service-card">

                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                    <path d="M5 28V4h22v24M2 28h6m16 0h6M5 16h22M5 25h22"/>
                    <rect x="8" y="7" width="12" height="6" rx="1"/>
                    <circle class="service-icon-accent" cx="23.5" cy="10" r="1"/>
                    <rect x="8" y="19" width="16" height="6" rx="1"/>
                    <path d="M13.5 19v6m5-6v6M10 22h1m4.5 0h1m4.5 0h1"/>
                </svg>

                <h3>Demo Systems</h3>

                <p>
                    Portable Training Equipment<br>
                    Universities & Industry
                </p>

            </article>

            <article class="service-card">

                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M16 8C12 5 8 4 3 6v19c5-2 9-1 13 2 4-3 8-4 13-2V6c-5-2-9-1-13 2Zm0 0v19M7 11h5m-5 4h5m-5 4h5"/><path class="service-icon-accent" d="M20 19v-6h5v6m-5-3h5"/></svg>

                <h3>Technical Training</h3>

                <p>
                    PLC · HMI · Drives · CNC
                </p>

            </article>

            <article class="service-card">
                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M4 5v22h24M9 21l6-7 5 3 7-9"/><circle class="service-icon-accent" cx="27" cy="8" r="2"/></svg>
                <h3>Industrial Data Collection</h3>
                <p>Capture machine and process data for traceability and reporting.</p>
            </article>

            <article class="service-card">
                <svg class="service-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="8" y="3" width="16" height="26" rx="3"/><path d="M13 24h6"/><path class="service-icon-accent" d="M12 12V9h3m5 3V9h-3m-5 5v3h3m5-3v3h-3"/></svg>
                <h3>Industrial Apps</h3>
                <p>Tools for equipment identification, field work and augmented reality guidance.</p>
                <a class="service-demo-link" href="#scanner-demo">Try the scanner demo →</a>
            </article>

        </div>

    </div>

</section>
<section class="projects" id="projects">

    <div class="container">

        <span class="section-tag">
            FEATURED PROJECTS
        </span>

        <h2>
            Automation Systems Designed & Built by AUSO
        </h2>

        <p class="section-description">
            From industrial automation to portable training equipment, every project
            is engineered with reliability, scalability and Siemens best practices.
        </p>

        <div class="projects-grid">

            <article class="project-card">

                <div class="project-image placeholder">
                    DEMO PHOTO
                </div>

                <div class="project-content">

                    <h3>S120 Motion Control Trainer</h3>

                    <p>
                        Portable industrial trainer with synchronized servo axes,
                        ET200SP distributed I/O and Siemens Motion Control.
                    </p>

                </div>

            </article>

            <article class="project-card">

                <div class="project-image placeholder">
                    DEMO PHOTO
                </div>

                <div class="project-content">

                    <h3>PLC Automation Cell</h3>

                    <p>
                        Modular automation platform for PLC, HMI, Profinet
                        and industrial communication training.
                    </p>

                </div>

            </article>

            <article class="project-card">

                <div class="project-image placeholder">
                    DEMO PHOTO
                </div>

                <div class="project-content">

                    <h3>Industrial Retrofit</h3>

                    <p>
                        Modernization of legacy machinery using Siemens PLCs,
                        WinCC Unified and variable speed drives.
                    </p>

                </div>

            </article>

        </div>

        <ScannerDemo />
    </div>

</section>
<section class="technologies" id="technologies">

    <div class="container">

        <span class="section-tag">
            TECHNOLOGIES
        </span>

        <h2>
            Technologies We Work With
        </h2>

        <p class="section-description">
            Specialized in Siemens industrial automation platforms,
            industrial communications and modern control technologies.
        </p>

        <div class="tech-grid">

            <div class="tech-card">TIA Portal</div>
            <div class="tech-card">S7-1200</div>
            <div class="tech-card">S7-1500</div>
            <div class="tech-card">WinCC Unified</div>
            <div class="tech-card">SINAMICS</div>
            <div class="tech-card">SIMOTION</div>
            <div class="tech-card">SINUMERIK</div>
            <div class="tech-card">PROFINET</div>
            <div class="tech-card">PROFIBUS</div>
            <div class="tech-card">OPC UA</div>
            <div class="tech-card">Modbus TCP</div>
            <div class="tech-card">Industrial Ethernet</div>

        </div>

    </div>

</section>
<section class="why-auso" id="about">

    <div class="container">

        <span class="section-tag">
            WHY AUSO
        </span>

        <h2>
            More Than Automation. Engineering Solutions.
        </h2>

        <p class="section-description">
            We combine industrial experience, Siemens technologies and practical
            training to deliver reliable automation solutions for universities,
            training centers and manufacturing industries.
        </p>

        <div class="stats-grid">

            <div class="stat-card">
                <span>15+</span>
                <p>Years of Experience</p>
            </div>

            <div class="stat-card">
                <span>200+</span>
                <p>Engineers Trained</p>
            </div>

            <div class="stat-card">
                <span>100+</span>
                <p>Industrial Projects</p>
            </div>

            <div class="stat-card">
                <span>Siemens</span>
                <p>Technology Specialist</p>
            </div>

        </div>

        <div class="why-grid">

            <div class="why-item">
                ✓ Custom Automation Projects
            </div>

            <div class="why-item">
                ✓ Portable Training Equipment
            </div>

            <div class="why-item">
                ✓ Motion Control Specialists
            </div>

            <div class="why-item">
                ✓ Industrial Networks
            </div>

            <div class="why-item">
                ✓ On-Site Technical Training
            </div>

            <div class="why-item">
                ✓ Technical Support
            </div>

        </div>

    </div>

</section>
<section class="training" id="training">

    <div class="container">

        <span class="section-tag">
            TRAINING
        </span>

        <h2>
            Professional Industrial Training
        </h2>

        <p class="section-description">
            Practical courses focused on real industrial applications using Siemens technologies.
            Designed for engineers, technicians, universities and manufacturing companies.
        </p>

        <div class="training-grid">

            <article class="course-card">
                <h3>PLC Programming</h3>
                <p>S7-1200 / S7-1500</p>
            </article>

            <article class="course-card">
                <h3>WinCC Unified</h3>
                <p>HMI & SCADA Development</p>
            </article>

            <article class="course-card">
                <h3>Motion Control</h3>
                <p>SINAMICS & SIMOTION</p>
            </article>

            <article class="course-card">
                <h3>Industrial Networks</h3>
                <p>PROFINET · PROFIBUS · OPC UA</p>
            </article>

            <article class="course-card">
                <h3>CNC Programming</h3>
                <p>SINUMERIK Systems</p>
            </article>

            <article class="course-card">
                <h3>Custom Training</h3>
                <p>Designed for your company</p>
            </article>

        </div>

    </div>

</section>
<section class="contact-section" id="contact">

    <div class="container">

        <div class="contact-box">

            <span class="section-tag">
                CONTACT
            </span>

            <h2>
                Ready to Start Your Next Automation Project?
            </h2>

            <p>
                Whether you need industrial automation, technical training,
                Siemens engineering or portable demo systems, we'd love to
                hear about your project.
            </p>

            <div class="contact-buttons">

                <a href="#" class="btn btn-primary">
                    Contact Us
                </a>

                <a href="#" class="btn btn-outline">
                    View Projects
                </a>

            </div>

        </div>

    </div>

</section>

