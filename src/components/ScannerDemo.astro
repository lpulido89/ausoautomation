---
const es = Astro.props.lang === "es";
---
<article class="scanner" id="scanner-demo" aria-labelledby="scanner-title">
  <div class="scanner-copy">
    <p class="section-tag">{es ? "DEMO INTERACTIVA" : "INTERACTIVE DEMO"}</p>
    <h3 id="scanner-title">{es ? "Escáner industrial de AUSO" : "AUSO Industrial Scanner"}</h3>
    <p>{es ? "Identifica una estación de capacitación, captura un registro de ejemplo y explora sus componentes en una vista de realidad aumentada simulada." : "Identify a training station, capture a sample record, and explore its components through a simulated augmented reality overlay."}</p>
    <p class="scanner-note">{es ? "Simulación · Datos de ejemplo · No requiere cámara" : "Simulation · Sample data · No camera required"}</p>
    <div class="scanner-actions">
      <button type="button" class="btn btn-primary" data-scan>{es ? "Simular escaneo" : "Simulate scan"}</button>
      <button type="button" class="btn btn-outline" data-overlay aria-pressed="false" aria-controls="scanner-overlay" disabled>{es ? "Mostrar realidad aumentada" : "Show AR overlay"}</button>
    </div>
    <dl class="scanner-record" hidden>
      <div><dt>{es ? "ID del equipo" : "Asset ID"}</dt><dd>AUSO-DEMO-01</dd></div>
      <div><dt>{es ? "Ubicación" : "Location"}</dt><dd>{es ? "Laboratorio de capacitación" : "Training lab"}</dd></div>
      <div><dt>{es ? "Resultado" : "Result"}</dt><dd>{es ? "Estación identificada" : "Station identified"}</dd></div>
    </dl>
    <p class="scanner-status" role="status"></p>
    <a href="#contact">{es ? "Cuéntanos sobre tu aplicación →" : "Talk to us about your application →"}</a>
  </div>
  <figure class="scanner-figure">
    <img src="/images/auso-training-station-scanner.webp" width="1200" height="1500" loading="lazy" decoding="async" alt={es ? "Vista frontal de una estación de capacitación con PLC, panel de operador y motor" : "Front view of an industrial training station with a PLC, operator panel, and motor"} />
    <div id="scanner-overlay" class="scanner-overlay" hidden>
      <button type="button" class="scanner-label hmi" data-component={es ? "HMI · Consulta el estado de la máquina y los controles del operador." : "HMI · View machine status and operator controls."}>HMI</button>
      <button type="button" class="scanner-label plc" data-component={es ? "PLC · Lee los sensores y controla la secuencia de la estación." : "PLC · Read sensors and control the station sequence."}>PLC</button>
      <button type="button" class="scanner-label motor" data-component={es ? "Motor · Acciona el sistema de movimiento y demuestra el control de velocidad." : "Motor · Drive the motion system and demonstrate speed control."}>Motor</button>
    </div>
  </figure>
</article>

<script>
  const es = document.documentElement.lang === "es";
  const demo = document.querySelector('#scanner-demo');
  const scan = demo?.querySelector<HTMLButtonElement>('[data-scan]');
  const overlayButton = demo?.querySelector<HTMLButtonElement>('[data-overlay]');
  const overlay = demo?.querySelector<HTMLElement>('#scanner-overlay');
  const record = demo?.querySelector<HTMLElement>('.scanner-record');
  const status = demo?.querySelector('.scanner-status');
  if (scan && overlayButton && overlay && record && status) {
    scan.addEventListener('click', () => {
      const reset = !record.hidden;
      record.hidden = reset;
      overlay.hidden = true;
      overlayButton.disabled = reset;
      overlayButton.setAttribute('aria-pressed', 'false');
      scan.textContent = reset ? (es ? "Simular escaneo" : "Simulate scan") : (es ? "Reiniciar demo" : "Reset demo");
      status.textContent = reset ? (es ? "Demo reiniciada." : "Demo reset.") : (es ? "Escaneo de ejemplo completado. Se identificó el equipo AUSO-DEMO-01." : "Sample scan complete. Asset AUSO-DEMO-01 identified.");
    });
    overlayButton.addEventListener('click', () => {
      overlay.hidden = !overlay.hidden;
      overlayButton.setAttribute('aria-pressed', String(!overlay.hidden));
      status.textContent = overlay.hidden ? (es ? "Vista de realidad aumentada oculta." : "AR overlay hidden.") : (es ? "Selecciona PLC, HMI o Motor para explorar la estación." : "Select PLC, HMI, or Motor to explore the station.");
    });
    overlay.querySelectorAll<HTMLButtonElement>('[data-component]').forEach(button => {
      button.addEventListener('click', () => {
        status.textContent = button.dataset.component ?? '';
      });
    });
  }
</script>

<style>
  .scanner { scroll-margin-top:90px; display:grid; grid-template-columns:minmax(0, 1fr) minmax(0, 1.2fr); gap:clamp(20px,4vw,48px); align-items:center; margin-top:3rem; padding:clamp(20px,4vw,42px); border:1px solid #303643; border-radius:18px; background:#12151b; }
  .scanner h3 { color:#fff; font-size:clamp(1.5rem,3vw,2.3rem); margin-bottom:1rem; }
  .scanner-copy > p:not(.section-tag) { color:#b9c2ce; }
  .scanner-note { font-size:.85rem; margin-top:1rem; }
  .scanner-actions { display:flex; flex-wrap:wrap; gap:.7rem; margin-block:1.25rem; }
  .scanner-actions .btn { display:inline-flex; align-items:center; font:inherit; padding:.65rem 1rem; }
  .scanner-actions button:disabled { opacity:.5; cursor:not-allowed; }
  .scanner-copy > a { color:#ff8996; }
  .scanner-record:not([hidden]) { display:grid; gap:.45rem; margin-bottom:1rem; }
  .scanner-record div { display:flex; flex-wrap:wrap; gap:.5rem; }
  .scanner-record dt { color:#b9c2ce; }
  .scanner-record dd { color:#fff; }
  .scanner-status:not(:empty) { margin-bottom:1rem; }
  .scanner-figure { position:relative; margin:0; }
  .scanner-figure img { display:block; width:100%; height:auto; border-radius:12px; }
  .scanner-overlay { position:absolute; inset:0; }
  .scanner-label { position:absolute; color:#fff; background:#131923; border:1px solid #ff8996; border-radius:5px; padding:.2rem .4rem; font-size:clamp(.68rem,1.3vw,.85rem); transform:translate(-50%, -50%); white-space:nowrap; }
  .scanner-label { cursor:pointer; }
  .scanner-label:hover, .scanner-label:focus-visible { background:#a31f35; }
  .scanner-label.hmi { left:88%; top:37%; }
  .scanner-label.plc { left:35%; top:28%; }
  .scanner-label.motor { left:80%; top:49%; }
  @media(max-width:800px) { .scanner { grid-template-columns:1fr; } }
</style>
