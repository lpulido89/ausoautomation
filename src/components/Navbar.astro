---
const { lang } = Astro.props;
const es = lang === "es";
---
<nav class="navbar">

    <div class="container nav-content">

        <a href={es ? "/" : "/en/"} class="logo">

            <img src="/images/logo.png" alt="AUSO Logo">

        </a>

<button type="button" class="menu-toggle" aria-label={es ? "Menú de navegación" : "Navigation menu"} aria-controls="main-menu" aria-expanded="false">

    ☰

</button>

<ul class="nav-links" id="main-menu">

    <li><a href="#top">{es ? "Inicio" : "Home"}</a></li>

    <li><a href="#services">{es ? "Servicios" : "Services"}</a></li>

    <li><a href="#projects">{es ? "Proyectos" : "Projects"}</a></li>

    <li><a href="#training">{es ? "Capacitación" : "Training"}</a></li>

    <li><a href="#about">{es ? "Nosotros" : "Why AUSO"}</a></li>

    <li><a href="/portal/" class="portal-link">{es ? "Portal de clientes" : "Client Portal"}</a></li>

    <li class="mobile-contact"><a href="#contact">{es ? "Contáctanos" : "Contact Us"}</a></li>

</ul>

<div class="nav-actions">
<div class="language-switch" aria-label={es ? "Idioma" : "Language"} role="group">
    <a href="/" hreflang="es" lang="es" aria-label="Español" aria-current={es ? "page" : undefined}>ES</a>
    <span aria-hidden="true">/</span>
    <a href="/en/" hreflang="en" lang="en" aria-label="English" aria-current={!es ? "page" : undefined}>EN</a>
</div>
<a href="#contact" class="btn btn-outline nav-contact">

    {es ? "Contáctanos" : "Contact Us"}

</a>
</div>

    </div>

</nav>


<script is:inline>

document.addEventListener("DOMContentLoaded", () => {

    const navbar = document.querySelector(".navbar");
    const links = [...navbar.querySelectorAll('a[href^="#"]')];
    const sections = [...document.querySelectorAll("section[id]")].filter(section =>
        links.some(link => link.hash === "#" + section.id)
    );

    const menuButton = document.querySelector(".menu-toggle");
    const menu = document.querySelector(".nav-links");

    function updateNavigation() {
        navbar.classList.toggle("scrolled", window.scrollY > 80);
        const boundary = navbar.getBoundingClientRect().bottom + 64;
        const current = sections.findLast(section => section.getBoundingClientRect().top <= boundary);
        for (const link of links) {
            const active = current && link.hash === "#" + current.id;
            if (active) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
        }
    }

    window.addEventListener("scroll", updateNavigation, { passive: true });
    window.addEventListener("resize", updateNavigation);
    window.addEventListener("pageshow", updateNavigation);
    updateNavigation();

    // Menú móvil
    menuButton.addEventListener("click", () => {

        menu.classList.toggle("open");
        menuButton.setAttribute("aria-expanded", String(menu.classList.contains("open")));

        menuButton.textContent =
            menu.classList.contains("open") ? "✕" : "☰";

    });

    // Cerrar menú al pulsar un enlace
    menu.querySelectorAll("a").forEach(link => {

        link.addEventListener("click", () => {

            menu.classList.remove("open");
            menuButton.setAttribute("aria-expanded", "false");
            menuButton.textContent = "☰";

        });

    });

});

</script>
