---
interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = (es: string, en: string) => lang === "es" ? es : en;
const formId = import.meta.env.PUBLIC_CONTACT_FORM_ID?.trim();
const endpoint = formId && /^[a-z0-9]+$/i.test(formId)
    ? `https://formspree.io/f/${formId}`
    : undefined;
---

{endpoint && <form
    class="contact-form"
    method="post"
    action={endpoint}
    data-contact-form
    data-sending={t("Enviando…", "Sending…")}
    data-success={t("Mensaje enviado. Gracias por escribirnos.", "Message sent. Thanks for reaching out.")}
    data-error={t("No se pudo enviar el mensaje. Intenta de nuevo o escribe a contact@ausoautomation.com.", "Your message could not be sent. Try again or email contact@ausoautomation.com.")}
>
    <label>
        {t("Nombre", "Name")}
        <input name="name" autocomplete="name" maxlength="120" required />
    </label>

    <label>
        {t("Correo electrónico", "Email")}
        <input name="email" type="email" autocomplete="email" maxlength="254" required />
    </label>

    <label class="contact-message">
        {t("Mensaje", "Message")}
        <textarea name="message" rows="5" maxlength="4000" required></textarea>
    </label>

    <div hidden>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <div class="contact-submit">
        <button type="submit" class="btn btn-primary">
            {t("Enviar mensaje", "Send message")}
        </button>
        <span role="status" data-contact-status></span>
    </div>
</form>}

<script>
    for (const form of document.querySelectorAll<HTMLFormElement>("[data-contact-form]")) {
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const status = form.querySelector<HTMLElement>("[data-contact-status]");
        if (!button || !status) continue;

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (button.disabled) return;

            const data = new FormData(form);
            button.disabled = true;
            status.textContent = form.dataset.sending ?? "";

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: data,
                    headers: { Accept: "application/json" },
                    redirect: "error",
                });
                if (!response.ok) throw new Error("Contact submission failed");

                form.reset();
                status.textContent = form.dataset.success ?? "";
            } catch {
                status.textContent = form.dataset.error ?? "";
            } finally {
                button.disabled = false;
            }
        });
    }
</script>

<style>
    .contact-form {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
        gap: 1rem;
        max-width: 680px;
        margin: 1.75rem auto 0;
        text-align: left;
    }

    label {
        display: grid;
        gap: 0.4rem;
        min-width: 0;
        font-weight: 600;
    }

    input,
    textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #555b66;
        border-radius: 8px;
        background: #0e1116;
        color: inherit;
        font: inherit;
        font-weight: 400;
    }

    textarea {
        resize: vertical;
    }

    input:focus-visible,
    textarea:focus-visible {
        outline: 2px solid #ff5367;
        outline-offset: 2px;
    }

    .contact-message,
    .contact-submit {
        grid-column: 1 / -1;
    }

    .contact-submit {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1rem;
    }

    button {
        font-family: inherit;
        cursor: pointer;
    }

    button:disabled {
        cursor: default;
        opacity: 0.6;
    }

    [role="status"] {
        flex: 1 1 220px;
        color: #c7cbd3;
        line-height: 1.5;
    }

    [role="status"]:empty {
        flex-basis: 0;
    }
</style>
