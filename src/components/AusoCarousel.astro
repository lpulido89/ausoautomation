<section id="showcase" class="auso-showcase" aria-labelledby="auso-showcase-title" hidden>
  <div class="auso-showcase__heading">
    <span class="auso-showcase__tag">AUSO / PROJECTS</span>
    <h2 id="auso-showcase-title">Engineering in Action</h2>
    <p>Real projects. Practical technology. Industrial solutions.</p>
  </div>
  <div class="auso-showcase__frame">
    <img class="auso-showcase__image" alt="" loading="lazy" />
    <div class="auso-showcase__shade"></div>
    <div class="auso-showcase__text" aria-live="polite">
      <h3></h3><p></p>
    </div>
    <button class="auso-showcase__arrow auso-showcase__arrow--prev" type="button" aria-label="Previous photograph">‹</button>
    <button class="auso-showcase__arrow auso-showcase__arrow--next" type="button" aria-label="Next photograph">›</button>
  </div>
  <div class="auso-showcase__dots" role="group" aria-label="Select photograph"></div>
</section>
<style>
  .auso-showcase { color:#fff; background:#0c0e12; padding:clamp(55px,8vw,110px) 20px 65px; }
  .auso-showcase__heading { max-width:1140px; margin:0 auto 36px; text-align:center; }
  .auso-showcase__tag { color:#e32d48; font-size:.77rem; font-weight:800; letter-spacing:.22em; }
  .auso-showcase__heading h2 { font-size:clamp(2rem,4.2vw,3.5rem); letter-spacing:-.04em; margin:12px 0; }
  .auso-showcase__heading p { color:#a8acb8; }
  .auso-showcase__frame { max-width:1140px; height:clamp(330px,47vw,610px); position:relative; overflow:hidden; margin:0 auto; border-radius:16px; background:#171b22; border:1px solid #32343a; box-shadow:0 35px 70px rgba(0,0,0,.25); }
  .auso-showcase__image { width:100%; height:100%; object-fit:cover; display:block; }
  .auso-showcase__shade { position:absolute; inset:0; background:linear-gradient(to top,rgba(5,5,7,.84) 0%,rgba(5,5,7,.3) 40%,transparent 75%); pointer-events:none; }
  .auso-showcase__text { position:absolute; bottom:clamp(25px,5vw,56px); left:clamp(26px,5vw,68px); right:clamp(26px,5vw,68px); pointer-events:none; max-width:750px; }
  .auso-showcase__text h3 { font-size:clamp(1.35rem,3vw,2.65rem); line-height:1.12; margin:0 0 12px; letter-spacing:-.02em; }
  .auso-showcase__text p { color:#e2e3e7; font-size:clamp(.87rem,1.3vw,1.05rem); margin:0; line-height:1.55; }
  .auso-showcase__arrow { position:absolute; top:50%; transform:translateY(-50%); width:44px; height:58px; border:1px solid #ffffff55; border-radius:7px; background:#07090c8c; color:white; font-size:2rem; cursor:pointer; display:grid; place-items:center; }
  .auso-showcase__arrow:hover { background:#c92542; }
  .auso-showcase__arrow--prev { left:14px; }
  .auso-showcase__arrow--next { right:14px; }
  .auso-showcase__dots { display:flex; gap:10px; justify-content:center; margin-top:22px; }
  .auso-showcase__dots button { height:8px; width:8px; border:0; border-radius:50%; background:#565b65; cursor:pointer; padding:0; }
  .auso-showcase__dots button[aria-current=true] { background:#df2a47; width:27px; border-radius:9px; }
  @media(max-width:680px) { .auso-showcase__arrow { width:34px; height:43px; font-size:1.6rem; } .auso-showcase__text { left:22px; right:22px; bottom:22px; } .auso-showcase__text p { max-width:70%; } }
</style>
<script>
  const root = document.querySelector('.auso-showcase');
  if (root) {
    const image = root.querySelector('.auso-showcase__image');
    const title = root.querySelector('.auso-showcase__text h3');
    const description = root.querySelector('.auso-showcase__text p');
    const dots = root.querySelector('.auso-showcase__dots');
    const previous = root.querySelector('.auso-showcase__arrow--prev');
    const next = root.querySelector('.auso-showcase__arrow--next');
    let slides = [];
    let index = 0;
    let timer;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function show(nextIndex) {
      index = (nextIndex + slides.length) % slides.length;
      const item = slides[index];
      image.src = item.image;
      image.alt = item.title || 'AUSO project photograph';
      title.textContent = item.title || 'Industrial automation';
      description.textContent = item.description || '';
      for (const [i, dot] of Array.from(dots.children).entries()) dot.setAttribute('aria-current', String(i === index));
    }
    function start() {
      clearInterval(timer);
      if (!reduceMotion && slides.length > 1) timer = setInterval(() => show(index + 1), 6500);
    }
    function advance(delta) { show(index + delta); start(); }
    previous.addEventListener('click', () => advance(-1));
    next.addEventListener('click', () => advance(1));
    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', () => clearInterval(timer));
    root.addEventListener('focusout', (event) => { if (!root.contains(event.relatedTarget)) start(); });
    fetch('/api/carousel', {cache:'no-store'}).then(result => result.ok ? result.json() : {slides:[]}).then(data => {
      if (!Array.isArray(data.slides) || !data.slides.length) return;
      slides = data.slides;
      root.hidden = false;
      previous.hidden = next.hidden = slides.length <= 1;
      slides.forEach((item, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', `Show photograph ${i+1}`);
        dot.addEventListener('click', () => {show(i); start();});
        dots.append(dot);
      });
      show(0); start();
    }).catch(() => {});
  }
</script>
